{
  "schema_version": "qitos.sandbox.policy/v1",
  "image": "reference-image:locked",
  "image_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "workspace_mode": "private_copy",
  "workspace_destination": "/workspace",
  "input_mounts": [],
  "output_destination": "/results",
  "run_as_uid": 65532,
  "run_as_gid": 65532,
  "read_only_root": true,
  "drop_capabilities": true,
  "no_new_privileges": true,
  "allow_devices": false,
  "privileged": false,
  "host_pid": false,
  "host_ipc": false,
  "network_mode": "none",
  "egress_rules": [],
  "deny_private_networks": true,
  "secrets": [],
  "provider_requests_host_side": true,
  "supports_pause": false,
  "supports_snapshot": false,
  "supports_fork": false,
  "cleanup_policy": "destroy_exact_identity",
  "limits": {
    "cpu_count": 2.0,
    "memory_bytes": 2147483648,
    "pids": 256,
    "file_descriptors": 1024,
    "tmpfs_bytes": 268435456,
    "disk_bytes": 2147483648,
    "output_bytes": 2097152,
    "command_seconds": 180,
    "wall_seconds": 3600
  }
}
