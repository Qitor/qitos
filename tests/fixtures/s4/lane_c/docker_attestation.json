{
  "schema": "qitos.s4.lane_c.docker_attestation/v1",
  "evidence_kind": "required-inspect-shape",
  "backend": "docker",
  "required": {
    "mounts": [],
    "tmpfs": ["/tmp", "/workspace", "/results"],
    "network": "none",
